{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-release-label.sh\"",
            "statusMessage": "Checking PR for the 'release' label..."
          }
        ]
      }
    ]
  }
}
