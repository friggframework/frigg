{
    "extends": "@friggframework/eslint-config",
    "rules": {
        "no-console": "error",
        "no-restricted-syntax": [
            "error",
            {
                "selector": "CallExpression[callee.object.object.name='process'][callee.object.property.name=/^(stdout|stderr)$/][callee.property.name='write']",
                "message": "Write through the logger; only logs/sinks.js writes to fd 1"
            }
        ]
    },
    "overrides": [
        {
            "files": ["*.test.js", "__fixtures__/**", "jest-logger-setup.js"],
            "rules": {
                "no-console": "off",
                "no-restricted-syntax": "off"
            }
        },
        {
            "files": ["sinks.js"],
            "rules": {
                "no-restricted-syntax": "off"
            }
        }
    ]
}
