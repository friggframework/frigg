{
  "$schema": "https://friggframework.org/schemas/integration-definition/v0.1.json",
  "schemaVersion": "0.1",
  "id": "pipedrive-hubspot",
  "version": "1.0.0",
  "display": {
    "label": "Pipedrive \u21c4 HubSpot people",
    "description": "Keeps Pipedrive people and HubSpot contacts the same person on both sides, matched by email, then by phone.",
    "category": "CRM",
    "tags": [
      "crm",
      "contacts",
      "sync"
    ]
  },
  "modules": {
    "pipedrive": {
      "module": "pipedrive",
      "version": "^2.1"
    },
    "hubspot": {
      "module": "hubspot",
      "version": "^3"
    }
  },
  "settings": {},
  "syncs": [
    {
      "id": "people",
      "label": "People and contacts",
      "description": "A new or changed person on either side is created or updated on the other. A blank value never overwrites a filled one.",
      "source": "pipedrive.person",
      "target": "hubspot.contact",
      "direction": "two_way",
      "identity": {
        "match": [
          {
            "source": "emails[0].value",
            "target": "properties.email",
            "transform": "lowercase",
            "key": "email"
          },
          {
            "source": "phones[0].value",
            "target": "properties.phone",
            "transform": "to_e164_phone",
            "key": "phone"
          }
        ],
        "onAmbiguous": "skip"
      },
      "mapping": [
        {
          "source": "first_name",
          "target": "properties.firstname",
          "transform": "trim"
        },
        {
          "source": "last_name",
          "target": "properties.lastname",
          "transform": "trim"
        },
        {
          "source": "emails[0].value",
          "target": "properties.email",
          "transform": "lowercase"
        },
        {
          "source": "phones[0].value",
          "target": "properties.phone",
          "transform": "to_e164_phone"
        },
        {
          "target": "properties.hs_lead_status",
          "value": "NEW",
          "direction": "to_target"
        }
      ],
      "backfill": {
        "trigger": "userAction",
        "pageSize": 100
      },
      "ongoing": {
        "mode": "webhook"
      },
      "default": "on"
    }
  ],
  "workflows": [],
  "lifecycle": {
    "onInstall": [
      {
        "id": "personCreated",
        "use": "pipedrive.webhook.create",
        "with": {
          "subscription_url": "$.install.webhookUrls.pipedrive",
          "event_action": "create",
          "event_object": "person",
          "version": "2.0"
        }
      },
      {
        "id": "personChanged",
        "use": "pipedrive.webhook.create",
        "with": {
          "subscription_url": "$.install.webhookUrls.pipedrive",
          "event_action": "change",
          "event_object": "person",
          "version": "2.0"
        }
      }
    ],
    "onUninstall": [
      {
        "use": "foreach",
        "with": {
          "over": [
            "$.install.runtime.installed.personCreated.id",
            "$.install.runtime.installed.personChanged.id"
          ],
          "max": 2,
          "where": "$.item exists"
        },
        "do": [
          {
            "use": "pipedrive.webhook.delete",
            "with": {
              "id": "$.item"
            },
            "onError": "continue"
          }
        ]
      }
    ]
  }
}
