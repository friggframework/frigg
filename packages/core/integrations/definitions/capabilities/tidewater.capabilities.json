            "customer_id": "cus_3Hx9Pq1R",
            "status": "scheduled",
            "description": "Replace water heater (50 gal) and haul away old unit",
            "scheduled_start": "2026-10-20T13:00:00Z",
            "scheduled_end": "2026-10-20T16:00:00Z",
            "finished_at": null,
            "technician_ids": [
              "tech_A1",
              "tech_B7"
            ],
            "subtotal": 184500,
            "tax_amount": 15221,
            "total_amount": 199721,
