  },
  "webhook": {
    "scope": "installation",
    "topic": "{{body.event}}",
    "eventId": "{{body.event_id}}",
    "verify": "verifyWebhookSignature"
  },
  "capabilities": {
    "customer.get": {
      "kind": "read",
      "method": "getCustomer",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "customer"
    },
    "customer.list": {
      "kind": "read",
      "method": "listCustomers",
      "input": {
        "updated_since": {
          "type": "string"
        },
        "page": {
          "type": "number"
        },
        "page_size": {
          "type": "number"
        }
      },
      "output": "page<customer>"
    },
    "customer.create": {
      "kind": "write",
      "method": "createCustomer",
      "input": {
        "customer": {
          "type": "object",
          "required": true
        }
      },
      "output": "customer"
    },
    "customer.update": {
      "kind": "write",
      "method": "updateCustomer",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "customer": {
          "type": "object",
          "required": true
        }
      },
      "output": "customer"
    },
    "job.get": {
      "kind": "read",
      "method": "getJob",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "expand": {
          "type": "array"
        }
      },
      "output": "job"
    },
    "job.search": {
      "kind": "search",
      "method": "searchJobs",
      "input": {
        "external_invoice_id": {
          "type": "string"
        },
        "job_number": {
          "type": "number"
        },
        "customer_id": {
          "type": "string"
        }
      },
      "output": "job[]"
    },
    "job.lineItems": {
      "kind": "read",
      "method": "listJobLineItems",
      "input": {
        "jobId": {
          "type": "string",
          "required": true
        }
      },
      "output": "lineItem[]"
    },
    "job.update": {
      "kind": "write",
      "method": "updateJob",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "job": {
          "type": "object",
          "required": true
        }
      },
      "output": "job"
    },
    "job.markPaid": {
      "kind": "write",
      "method": "recordJobPayment",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "amount": {
          "type": "integer",
          "required": true
        },
        "paid_at": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      },
      "output": "job"
    },
    "job.addNote": {
      "kind": "write",
      "method": "createJobNote",
      "input": {
        "jobId": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        }
      },
      "output": "note"
    },
    "technician.list": {
      "kind": "read",
      "method": "listTechnicians",
      "input": {},
      "output": "technician[]"
    },
    "webhook.create": {
      "kind": "subscribe",
      "method": "createWebhookSubscription",
      "input": {
        "url": {
          "type": "string",
          "required": true
        },
        "events": {
          "type": "array",
          "required": true
        }
      },
      "output": "webhook"
    },
    "webhook.delete": {
      "kind": "delete",
      "method": "deleteWebhookSubscription",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "void"
    }
  },
  "options": {
    "technician": {
      "capability": "technician.list",
      "label": "{{item.name}}",
      "value": "$.item.id"
    }
  },
  "ui": {
    "placements": [
      "job.sidebar",
      "customer.sidebar"
    ],
    "renderer": "tidewater-extension-panel"
  }
}
