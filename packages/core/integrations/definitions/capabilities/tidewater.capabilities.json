{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "tidewater",
  "label": "Tidewater",
  "package": "@tidewater/frigg-api-module",
  "version": "0.9.0",
  "auth": "api_key",
  "objects": {
    "customer": {
      "label": "Customer",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "display_name",
          "type": "string",
          "tag": "record.displayName"
        },
        {
          "name": "first_name",
          "type": "string",
          "tag": "person.givenName"
        },
        {
          "name": "last_name",
          "type": "string",
          "tag": "person.familyName"
        },
        {
          "name": "company_name",
          "type": "string",
          "tag": "organization.name"
        },
        {
          "name": "email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "mobile_number",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "address.street",
          "type": "string",
          "tag": "address.line1"
        },
        {
          "name": "address.city",
          "type": "string",
          "tag": "address.locality"
        },
        {
          "name": "address.state",
          "type": "string",
          "tag": "address.region"
        },
        {
          "name": "address.zip",
          "type": "string",
          "tag": "address.postalCode"
        },
        {
          "name": "tags",
          "type": "string[]",
          "tag": "record.tags"
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "tag": "record.updatedAt",
          "readOnly": true
        }
      ],
      "sync": {
        "id": "id",
        "updatedAt": "updated_at",
        "list": {
          "capability": "customer.list",
          "cursor": "page",
          "limit": "page_size",
          "since": "updated_since",
          "items": "customers",
          "paging": "page"
        },
        "get": {
          "capability": "customer.get",
          "id": "id"
        },
        "create": {
          "capability": "customer.create",
          "body": "customer"
        },
        "update": {
          "capability": "customer.update",
          "id": "id",
          "body": "customer"
        }
      }
    },
    "job": {
      "label": "Job",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "job_number",
          "type": "number",
          "tag": "record.displayId",
          "readOnly": true
        },
        {
          "name": "customer_id",
          "type": "string"
        },
        {
          "name": "status",
          "type": "enum",
          "tag": "job.status",
          "values": [
            "scheduled",
            "dispatched",
            "in_progress",
            "finished",
            "invoiced",
            "paid",
            "canceled"
          ]
        },
        {
          "name": "description",
          "type": "text"
        },
        {
          "name": "scheduled_start",
          "type": "datetime",
          "tag": "job.scheduledStart"
        },
        {
          "name": "scheduled_end",
          "type": "datetime",
          "tag": "job.scheduledEnd"
        },
        {
          "name": "finished_at",
          "type": "datetime",
          "tag": "job.completedAt"
        },
        {
          "name": "technician_ids",
          "type": "string[]",
          "tag": "record.owner"
        },
        {
          "name": "subtotal",
          "type": "integer",
          "tag": "order.subtotal",
          "readOnly": true
        },
        {
          "name": "tax_amount",
          "type": "integer",
          "tag": "order.tax",
          "readOnly": true
        },
        {
          "name": "total_amount",
          "type": "integer",
          "tag": "order.total",
          "readOnly": true
        },
        {
          "name": "payment_status",
          "type": "enum",
          "tag": "order.paymentStatus",
          "values": [
            "unpaid",
            "partially_paid",
            "paid"
          ]
        },
        {
          "name": "external_invoice_id",
          "type": "string",
          "tag": "record.externalId"
        }
      ]
    },
    "lineItem": {
      "label": "Line item",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "job_id",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "enum",
          "values": [
            "service",
            "labor",
            "material",
            "fee",
            "discount"
          ]
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "description",
          "type": "text"
        },
        {
          "name": "sku",
          "type": "string"
        },
        {
          "name": "quantity",
          "type": "number"
        },
        {
          "name": "unit_price",
          "type": "integer"
        },
        {
          "name": "unit_cost",
          "type": "integer"
        },
        {
          "name": "taxable",
          "type": "boolean"
        }
      ]
    },
    "technician": {
      "label": "Technician",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "name",
          "type": "string",
          "tag": "person.fullName"
        },
        {
          "name": "email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "phone",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "role",
          "type": "string"
        }
      ]
    }
  },
  "events": {
