        },
        {
          "name": "Phone",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "AccountId",
          "type": "string"
        },
        {
          "name": "OwnerId",
          "type": "string",
          "tag": "record.owner"
        }
      ]
