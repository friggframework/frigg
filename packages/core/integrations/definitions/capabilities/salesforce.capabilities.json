    "opportunity": {
      "label": "Opportunity",
      "fields": [
        {
          "name": "Id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "Name",
          "type": "string",
          "tag": "deal.name"
        },
        {
          "name": "StageName",
          "type": "enum",
          "tag": "deal.stage",
          "values": [
            "Prospecting",
            "Qualification",
            "Needs Analysis",
            "Value Proposition",
            "Proposal/Price Quote",
            "Negotiation/Review",
            "Closed Won",
            "Closed Lost"
