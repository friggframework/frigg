      "fields": [
        {
          "name": "Id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "Subject",
          "type": "string",
          "required": true
        },
        {
          "name": "Status",
          "type": "enum",
          "values": [
            "Not Started",
            "In Progress",
            "Completed",
            "Waiting on someone else",
            "Deferred"
          ]
        },
        {
          "name": "Priority",
          "type": "enum",
          "values": [
            "High",
            "Normal",
            "Low"
          ]
        },
        {
          "name": "ActivityDate",
          "type": "date"
        },
        {
          "name": "WhoId",
          "type": "string"
        },
        {
          "name": "WhatId",
          "type": "string"
        },
        {
          "name": "OwnerId",
          "type": "string",
          "tag": "record.owner"
        },
        {
          "name": "Description",
          "type": "text"
        }
      ]
    }
  },
  "events": {
    "opportunity.changed": {
      "delivery": "webhook",
      "object": "opportunity",
      "description": "Change Data Capture (OpportunityChangeEvent) relayed through the Pub/Sub API subscriber; routed by organization id.",
      "payload": {
        "id": "0WS8c000000abcdGAA",
        "schema": "IeRuaY6cbI_HsV8Rv1Mc5g",
        "payload": {
          "ChangeEventHeader": {
            "entityName": "Opportunity",
            "recordIds": [
              "0068c00000ABCDeAAP"
            ],
            "changeType": "UPDATE",
            "changedFields": [
              "StageName"
            ],
            "commitTimestamp": 1760958061000
          },
          "StageName": "Negotiation/Review"
        }
      },
      "record": "payload",
      "match": "Opportunity.UPDATE"
    }
  },
  "webhook": {
    "scope": "installation",
    "topic": "{{body.payload.ChangeEventHeader.entityName}}.{{body.payload.ChangeEventHeader.changeType}}",
    "eventId": "{{body.id}}",
    "verify": "verifyWebhookSignature",
    "status": "unimplemented",
    "note": "Not a webhook: change-data-capture events arrive over the Pub/Sub or CometD stream the module opens itself, and Salesforce Outbound Messages are unsigned (check OrganizationId plus an IP allowlist). Stays unimplemented, so a delivery here is rejected, never accepted unchecked."
  },
  "capabilities": {
    "lead.get": {
      "kind": "read",
      "method": "get",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "lead",
      "args": [
        {
          "value": "Lead"
        },
        "id"
      ]
    },
    "lead.create": {
      "kind": "write",
      "method": "create",
      "input": {
        "fields": {
          "type": "object",
          "required": true
        }
      },
      "output": "lead",
      "args": [
