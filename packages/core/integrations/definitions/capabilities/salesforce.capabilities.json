          "value": "Lead"
        },
        "fields"
      ]
    },
    "lead.update": {
      "kind": "write",
      "method": "updateLead",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "fields": {
          "type": "object",
          "required": true
        }
      },
      "output": "void",
      "status": "unimplemented",
      "note": "Api.update(object, data) needs the record id inside data (data.Id); the capability passes the id separately, so there is no way to call it."
    },
    "person.searchByEmail": {
      "kind": "search",
      "method": "searchPeopleByEmail",
      "label": "SOSL across Lead and Contact",
      "input": {
        "email": {
          "type": "string",
          "required": true
        }
      },
      "output": "{ leads: lead[], contacts: contact[] }",
      "status": "unimplemented",
      "note": "Api.find(object, filter) searches one sObject at a time; searching Lead and Contact together would need two calls."
    },
    "event.create": {
      "kind": "write",
      "method": "create",
      "input": {
        "fields": {
          "type": "object",
          "required": true
