          "readOnly": true
        },
        {
          "name": "FirstName",
          "type": "string",
          "tag": "person.givenName"
        },
        {
          "name": "LastName",
          "type": "string",
          "tag": "person.familyName",
          "required": true
        },
        {
          "name": "Email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "Phone",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "Company",
          "type": "string",
          "tag": "organization.name",
          "required": true
        },
        {
          "name": "Title",
          "type": "string",
          "tag": "person.jobTitle"
        },
        {
          "name": "LeadSource",
          "type": "string",
          "tag": "marketing.source"
        },
        {
          "name": "Status",
          "type": "enum",
          "tag": "contact.leadStatus",
