            "Open - Not Contacted",
            "Working - Contacted",
            "Closed - Converted",
            "Closed - Not Converted"
          ]
        },
        {
          "name": "OwnerId",
          "type": "string",
          "tag": "record.owner"
        },
        {
          "name": "Description",
          "type": "text"
        },
        {
          "name": "IsConverted",
          "type": "boolean",
          "readOnly": true
        }
      ]
    },
