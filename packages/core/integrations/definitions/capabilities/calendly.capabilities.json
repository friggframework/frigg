      "record": "payload",
      "idPath": "payload.uri"
    }
  },
  "webhook": {
    "scope": "installation",
    "topic": "{{body.event}}",
    "eventId": "{{body.payload.uri}}:{{body.event}}",
    "verify": "verifyWebhookSignature"
  },
  "capabilities": {
    "invitee.get": {
      "kind": "read",
      "method": "getInvitee",
      "input": {
        "uri": {
          "type": "string",
          "required": true
        }
      },
      "output": "invitee"
    },
    "event.get": {
      "kind": "read",
      "method": "getScheduledEvent",
      "input": {
        "uri": {
          "type": "string",
          "required": true
        }
      },
      "output": "scheduledEvent"
    },
    "event.list": {
      "kind": "read",
      "method": "listScheduledEvents",
      "input": {
        "organization": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "invitee_email": {
          "type": "string"
        },
        "min_start_time": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "count": {
          "type": "number"
        }
      },
      "output": "scheduledEvent[]"
    },
    "eventType.list": {
      "kind": "read",
      "method": "listEventTypes",
      "input": {
        "organization": {
          "type": "string"
        }
      },
      "output": "eventType[]"
    },
    "webhook.create": {
      "kind": "subscribe",
      "method": "createWebhookSubscription",
      "input": {
        "url": {
          "type": "string",
          "required": true
        },
        "events": {
          "type": "array",
          "required": true
        },
        "organization": {
          "type": "string",
          "required": true
        },
        "scope": {
          "type": "string",
          "required": true
        },
        "signing_key": {
          "type": "string"
        }
      },
      "output": "webhookSubscription"
    },
    "webhook.delete": {
      "kind": "delete",
      "method": "deleteWebhookSubscription",
      "input": {
        "uri": {
          "type": "string",
          "required": true
        }
      },
      "output": "void"
    }
  },
  "options": {
    "eventType": {
      "capability": "eventType.list",
      "label": "{{item.name}}",
      "value": "$.item.uri"
    }
  }
}
