{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "calendly",
  "label": "Calendly",
  "package": "@friggframework/api-module-calendly",
  "version": "1.0.4",
  "auth": "oauth2",
  "account": {
    "description": "Values about the connected account, persisted by the module (apiPropertiesToPersist). Definitions read them as $.install.accounts.<module key>.<name>.",
    "fields": [
      {
        "name": "organization",
        "type": "string",
        "description": "Organization URI of the connected Calendly user"
      },
      {
        "name": "user",
        "type": "string",
        "description": "User URI of the connected Calendly user"
      }
    ]
  },
  "objects": {
    "invitee": {
      "label": "Invitee",
      "fields": [
        {
          "name": "uri",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "name",
          "type": "string",
          "tag": "person.fullName"
        },
        {
          "name": "first_name",
          "type": "string",
          "tag": "person.givenName"
        },
        {
          "name": "last_name",
          "type": "string",
          "tag": "person.familyName"
        },
        {
          "name": "text_reminder_number",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "timezone",
          "type": "string",
          "tag": "person.timezone"
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "active",
            "canceled"
          ],
          "readOnly": true
        },
        {
          "name": "questions_and_answers",
          "type": "json"
        },
        {
          "name": "tracking.utm_source",
          "type": "string",
          "tag": "marketing.source"
        },
        {
          "name": "tracking.utm_campaign",
          "type": "string",
          "tag": "marketing.campaign"
        },
        {
          "name": "cancellation.reason",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "tag": "record.createdAt",
          "readOnly": true
        }
      ]
    },
    "scheduledEvent": {
      "label": "Scheduled event",
      "fields": [
        {
          "name": "uri",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "name",
          "type": "string",
          "tag": "meeting.title"
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "active",
            "canceled"
          ]
        },
        {
          "name": "start_time",
          "type": "datetime",
          "tag": "meeting.start"
        },
        {
          "name": "end_time",
          "type": "datetime",
          "tag": "meeting.end"
        },
        {
          "name": "location.join_url",
          "type": "string",
          "tag": "meeting.joinUrl"
        },
        {
          "name": "event_type",
          "type": "string"
        },
        {
          "name": "event_memberships",
          "type": "json",
          "tag": "record.owner"
        }
      ]
    }
  },
  "events": {
