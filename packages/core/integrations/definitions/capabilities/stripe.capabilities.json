  },
  "webhook": {
    "scope": "app",
    "topic": "{{body.type}}",
    "eventId": "{{body.id}}",
    "account": "{{body.account}}",
    "verify": "verifyWebhookSignature",
    "note": "Stripe-Signature t=…,v1=… over t.raw body, 300 s tolerance; rolling secrets accepted. Implemented in api-module-library 659b90d; needs the module release that includes it."
  },
  "capabilities": {
    "customer.get": {
      "kind": "read",
      "method": "retrieveCustomer",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "customer",
      "args": [
        "id"
      ]
    },
    "customer.list": {
      "kind": "read",
      "method": "listCustomers",
      "input": {
        "created_gte": {
          "type": "number"
        },
        "limit": {
          "type": "number"
        },
        "starting_after": {
          "type": "string"
        }
      },
      "output": "page<customer>",
      "args": [
        "$rest"
      ]
    },
    "customer.search": {
      "kind": "search",
      "method": "searchCustomers",
      "input": {
        "query": {
          "type": "string",
          "required": true
        }
      },
      "output": "customer[]",
      "args": [
        "query"
      ]
    },
    "customer.create": {
      "kind": "write",
      "method": "createCustomer",
      "input": {
        "params": {
          "type": "object",
          "required": true
        }
      },
      "output": "customer",
      "args": [
        "params"
      ]
    },
    "customer.update": {
      "kind": "write",
      "method": "updateCustomer",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "params": {
          "type": "object",
          "required": true
        }
      },
      "output": "customer",
      "args": [
        "id",
        "params"
      ]
    },
    "paymentIntent.get": {
      "kind": "read",
      "method": "retrievePaymentIntent",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "expand": {
          "type": "array"
        }
      },
      "output": "paymentIntent",
      "args": [
        "id",
        "$rest"
      ]
    },
    "refund.get": {
      "kind": "read",
      "method": "retrieveRefund",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "refund",
      "args": [
        "id"
      ]
    },
    "payout.list": {
      "kind": "read",
      "method": "listPayouts",
      "input": {
        "status": {
          "type": "string"
        },
        "arrivedAfter": {
          "type": "string"
        },
        "arrivedBefore": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        }
      },
      "output": "payout[]",
      "args": [
        "$rest"
      ]
    },
    "balanceTransaction.list": {
      "kind": "read",
      "method": "getBalanceTransactions",
      "input": {
        "payout": {
          "type": "string",
          "required": true
        },
        "type": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        }
      },
      "output": "balanceTransaction[]"
    }
  }
}
