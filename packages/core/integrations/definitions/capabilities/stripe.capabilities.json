        "id": "evt_1QBz8kLkdIwHu7ix3XyZ9aQe",
        "object": "event",
        "account": "acct_1Nv0FGQ9RKHgCVdK",
        "api_version": "2024-06-20",
        "created": 1760800000,
        "livemode": true,
        "type": "payment_intent.succeeded",
        "data": {
          "object": {
            "id": "pi_3QBz8jLkdIwHu7ix1Zt0nXyQ",
            "object": "payment_intent",
            "amount": 13970,
            "amount_received": 13970,
            "currency": "usd",
            "customer": "cus_QzX1fL0aB2cD3e",
            "description": "Invoice INV-2026-0142",
            "receipt_email": "dana.reyes@example.com",
