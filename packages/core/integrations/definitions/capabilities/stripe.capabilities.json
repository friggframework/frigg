      "object": "refund",
      "payload": {
        "id": "evt_1QBz8kLkdIwHu7ix3XyZ9aQe",
        "object": "event",
        "account": "acct_1Nv0FGQ9RKHgCVdK",
        "api_version": "2024-06-20",
        "created": 1760800000,
        "livemode": true,
        "type": "refund.created",
        "data": {
          "object": {
            "id": "re_3QBz8jLkdIwHu7ix1aBcDeFg",
            "object": "refund",
            "amount": 3118,
            "currency": "usd",
            "charge": "ch_3QBz8jLkdIwHu7ix1Kk4mPqR",
            "payment_intent": "pi_3QBz8jLkdIwHu7ix1Zt0nXyQ",
            "reason": "requested_by_customer",
            "status": "succeeded",
            "created": 1760990000
          }
        }
      },
      "record": "data.object"
    },
