{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "stripe",
  "label": "Stripe",
  "package": "@friggframework/api-module-stripe",
  "version": "2.3.0",
  "auth": "oauth2",
  "objects": {
    "customer": {
      "label": "Customer",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "name",
          "type": "string",
          "tag": "person.fullName"
        },
        {
          "name": "phone",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "description",
          "type": "text"
        },
        {
          "name": "address.line1",
          "type": "string",
          "tag": "address.line1"
        },
        {
          "name": "address.city",
          "type": "string",
          "tag": "address.locality"
        },
        {
          "name": "address.state",
          "type": "string",
          "tag": "address.region"
        },
        {
          "name": "address.postal_code",
          "type": "string",
          "tag": "address.postalCode"
        },
        {
          "name": "address.country",
          "type": "string",
          "tag": "address.country"
        },
        {
          "name": "currency",
          "type": "string"
        },
        {
          "name": "metadata.quickbooks_id",
          "type": "string",
          "tag": "record.externalId"
        },
        {
          "name": "created",
          "type": "timestamp",
          "tag": "record.createdAt",
          "readOnly": true
        }
      ],
      "sync": {
        "id": "id",
        "list": {
          "capability": "customer.list",
          "cursor": "starting_after",
          "limit": "limit",
          "items": "data",
          "next": "lastId"
        },
        "get": {
          "capability": "customer.get",
          "id": "id"
        },
        "create": {
          "capability": "customer.create",
          "body": "params"
        },
        "update": {
          "capability": "customer.update",
          "id": "id",
          "body": "params"
        }
      }
    },
    "paymentIntent": {
      "label": "Payment intent",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "amount",
          "type": "integer",
          "tag": "payment.amountMinor"
        },
        {
          "name": "amount_received",
          "type": "integer",
          "readOnly": true
        },
        {
          "name": "currency",
          "type": "string",
          "tag": "payment.currency"
        },
        {
          "name": "customer",
          "type": "string"
        },
        {
          "name": "description",
          "type": "text"
        },
        {
          "name": "receipt_email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "status",
          "type": "enum",
          "tag": "payment.status",
          "values": [
            "requires_payment_method",
            "requires_confirmation",
            "requires_action",
            "processing",
            "requires_capture",
            "canceled",
            "succeeded"
          ],
          "readOnly": true
        },
        {
          "name": "latest_charge",
          "type": "string",
          "readOnly": true
        },
        {
          "name": "metadata",
          "type": "json"
        },
        {
          "name": "created",
          "type": "timestamp",
          "tag": "record.createdAt",
          "readOnly": true
        }
      ]
    },
    "refund": {
      "label": "Refund",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "amount",
          "type": "integer",
          "tag": "payment.amountMinor"
        },
        {
          "name": "currency",
          "type": "string",
          "tag": "payment.currency"
        },
        {
          "name": "charge",
          "type": "string"
        },
        {
          "name": "payment_intent",
          "type": "string"
        },
        {
          "name": "reason",
          "type": "enum",
          "values": [
            "duplicate",
            "fraudulent",
            "requested_by_customer",
            "expired_uncaptured_charge"
          ]
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "pending",
            "requires_action",
            "succeeded",
            "failed",
            "canceled"
          ],
          "readOnly": true
        },
        {
          "name": "created",
          "type": "timestamp",
          "tag": "record.createdAt",
          "readOnly": true
        }
      ]
    },
    "payout": {
      "label": "Payout",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "amount",
          "type": "integer",
          "tag": "payment.amountMinor"
        },
        {
          "name": "currency",
          "type": "string",
          "tag": "payment.currency"
        },
        {
          "name": "arrival_date",
          "type": "timestamp"
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "paid",
            "pending",
            "in_transit",
            "canceled",
            "failed"
          ],
          "readOnly": true
        },
        {
          "name": "automatic",
          "type": "boolean"
        },
        {
          "name": "balance_transaction",
          "type": "string"
        },
        {
          "name": "statement_descriptor",
          "type": "string"
        }
      ]
    },
    "balanceTransaction": {
      "label": "Balance transaction",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "amount",
          "type": "integer"
        },
        {
          "name": "fee",
          "type": "integer"
        },
        {
          "name": "net",
          "type": "integer"
        },
        {
          "name": "currency",
          "type": "string"
        },
        {
          "name": "type",
          "type": "enum",
          "values": [
            "charge",
            "payment",
            "refund",
            "adjustment",
            "stripe_fee",
            "payout",
            "application_fee"
          ]
        },
        {
          "name": "reporting_category",
          "type": "string"
        },
        {
          "name": "source",
          "type": "string"
        },
        {
          "name": "created",
          "type": "timestamp",
          "readOnly": true
        }
      ]
    }
  },
  "events": {
    "payment_intent.succeeded": {
      "delivery": "webhook",
      "object": "paymentIntent",
      "description": "Connect webhook: one app-level endpoint receives events for every connected account; Frigg routes by `account`. No per-install subscription.",
