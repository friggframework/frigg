                }
              ]
            },
            "customFields": {
              "textCustomFields": [
                {
                  "fieldId": "10498",
                  "name": "SalesforceOpportunityId",
                  "value": "0068c00000ABCDeAAP",
                  "show": "false"
                }
              ]
            },
            "declinedDateTime": "2026-10-20T13:12:00.000Z"
          }
        }
      },
      "record": "data.envelopeSummary",
      "match": "envelope-declined"
    },
    "envelope.sent": {
      "delivery": "webhook",
      "object": "envelope",
      "subscribe": "connect.create",
      "payload": {
        "event": "envelope-sent",
        "apiVersion": "v2.1",
        "uri": "/restapi/v2.1/accounts/9c1b2f3e/envelopes/7d2e8f14-3a6b-4c91-9e20-5b1f7c8a2d63",
        "retryCount": 0,
        "configurationId": 10457,
        "generatedDateTime": "2026-10-20T16:00:02.112Z",
        "data": {
          "accountId": "9c1b2f3e-1a2b-4c3d-8e9f-0a1b2c3d4e5f",
          "userId": "4b2a1e8c-0a1b-4c55-9d1b-6f4b2a1e8c33",
          "envelopeId": "7d2e8f14-3a6b-4c91-9e20-5b1f7c8a2d63",
          "envelopeSummary": {
            "envelopeId": "7d2e8f14-3a6b-4c91-9e20-5b1f7c8a2d63",
            "status": "sent",
            "emailSubject": "Please sign: Acme Corp MSA and Work Order 3",
            "sentDateTime": "2026-10-19T14:00:00.000Z",
            "sender": {
              "userName": "Sean Matthews",
              "email": "sean@lefthook.example"
            },
            "recipients": {
              "signers": [
                {
                  "recipientId": "1",
                  "name": "Priya Natarajan",
                  "email": "priya@acme.example",
                  "status": "sent",
                  "routingOrder": "1"
                }
              ]
            },
            "customFields": {
              "textCustomFields": [
                {
                  "fieldId": "10498",
                  "name": "SalesforceOpportunityId",
                  "value": "0068c00000ABCDeAAP",
                  "show": "false"
                }
              ]
            }
          }
        }
      },
      "record": "data.envelopeSummary",
      "match": "envelope-sent"
    }
  },
  "webhook": {
    "scope": "installation",
    "topic": "{{body.event}}",
    "eventId": "{{body.data.envelopeId}}:{{body.event}}:{{body.generatedDateTime}}",
    "verify": "verifyWebhookSignature"
  },
  "capabilities": {
    "envelope.get": {
      "kind": "read",
      "method": "getEnvelope",
      "input": {
        "envelopeId": {
          "type": "string",
          "required": true
        },
        "include": {
          "type": "string"
        }
      },
      "output": "envelope"
    },
    "envelope.list": {
      "kind": "read",
      "method": "listStatusChanges",
      "input": {
        "from_date": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "custom_field": {
          "type": "string"
        },
        "count": {
          "type": "number"
        }
      },
      "output": "envelope[]"
    },
    "document.combined": {
      "kind": "read",
      "method": "getCombinedDocument",
      "input": {
        "envelopeId": {
          "type": "string",
          "required": true
        },
        "certificate": {
          "type": "boolean"
        }
      },
      "output": "{ base64: string, contentType: string }"
    },
    "connect.create": {
      "kind": "subscribe",
      "method": "createConnectConfiguration",
      "input": {
        "name": {
          "type": "string",
          "required": true
        },
        "urlToPublishTo": {
          "type": "string",
          "required": true
        },
        "events": {
          "type": "array",
          "required": true
        }
      },
      "output": "connectConfiguration"
    },
    "connect.delete": {
      "kind": "delete",
      "method": "deleteConnectConfiguration",
      "input": {
        "connectId": {
          "type": "string",
          "required": true
        }
      },
      "output": "void"
    }
  }
}
