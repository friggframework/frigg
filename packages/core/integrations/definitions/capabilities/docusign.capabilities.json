{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "docusign",
  "label": "DocuSign eSignature",
  "package": "@friggframework/api-module-docusign",
  "version": "1.2.0",
  "auth": "oauth2",
  "objects": {
    "envelope": {
      "label": "Envelope",
      "fields": [
        {
          "name": "envelopeId",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "status",
          "type": "enum",
          "tag": "agreement.status",
          "values": [
            "created",
            "sent",
            "delivered",
            "signed",
            "completed",
            "declined",
            "voided"
          ],
          "readOnly": true
        },
        {
          "name": "emailSubject",
          "type": "string",
          "tag": "agreement.title"
        },
        {
          "name": "sentDateTime",
          "type": "datetime",
          "readOnly": true
        },
        {
          "name": "completedDateTime",
          "type": "datetime",
          "tag": "agreement.completedAt",
          "readOnly": true
        },
        {
          "name": "declinedDateTime",
          "type": "datetime",
          "readOnly": true
        },
        {
          "name": "sender.email",
          "type": "email",
          "tag": "record.owner",
          "readOnly": true
        },
        {
          "name": "recipients.signers",
          "type": "json",
          "tag": "agreement.signers"
        },
        {
          "name": "customFields.textCustomFields",
          "type": "json"
        }
      ]
    }
  },
  "events": {
    "envelope.completed": {
