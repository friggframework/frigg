{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "linear",
  "label": "Linear",
  "package": "@friggframework/api-module-linear",
  "version": "1.1.0",
  "auth": "oauth2",
  "objects": {
    "issue": {
      "label": "Issue",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "identifier",
          "type": "string",
          "tag": "record.displayId",
          "readOnly": true
        },
        {
          "name": "title",
          "type": "string",
          "tag": "task.title",
          "required": true
        },
        {
          "name": "description",
          "type": "text",
          "tag": "task.description"
        },
        {
          "name": "priority",
          "type": "enum",
          "tag": "task.priority",
          "values": [
            0,
            1,
            2,
            3,
            4
          ]
        },
        {
          "name": "state.name",
          "type": "string",
          "tag": "task.state"
        },
        {
          "name": "state.type",
          "type": "enum",
          "values": [
            "triage",
            "backlog",
            "unstarted",
            "started",
            "completed",
            "canceled"
          ],
          "readOnly": true
        },
        {
          "name": "labelIds",
          "type": "string[]",
          "tag": "record.tags"
        },
        {
          "name": "assignee.email",
          "type": "email",
          "tag": "record.owner"
        },
        {
          "name": "team.key",
          "type": "string",
          "readOnly": true
        },
        {
          "name": "attachments[0].url",
          "type": "string",
          "tag": "record.externalUrl"
        },
        {
          "name": "url",
          "type": "string",
          "tag": "record.url",
          "readOnly": true
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "tag": "record.createdAt",
          "readOnly": true
        },
        {
          "name": "updatedAt",
          "type": "datetime",
          "tag": "record.updatedAt",
          "readOnly": true
        }
      ],
      "sync": {
        "id": "id",
        "updatedAt": "updatedAt",
        "get": {
          "capability": "issue.get",
          "id": "id"
        },
        "create": {
          "capability": "issue.create"
        },
        "update": {
          "capability": "issue.update",
          "id": "id",
          "body": "input"
        }
      }
    }
  },
  "events": {
    "issue.created": {
      "delivery": "webhook",
      "object": "issue",
      "description": "OAuth-app webhook configured once on the application; routed by organizationId. No per-install subscription.",
      "payload": {
        "action": "create",
        "type": "Issue",
        "createdAt": "2026-10-19T10:01:00.000Z",
        "organizationId": "b0c1d2e3-f4a5-4b6c-8d7e-9f0a1b2c3d4e",
        "webhookTimestamp": 1760868060000,
        "url": "https://linear.app/acme/issue/ENG-142",
        "data": {
          "id": "5f1a2b3c-4d5e-4f60-8a7b-9c0d1e2f3a4b",
          "identifier": "ENG-142",
          "title": "Webhook retries double-post comments",
          "priority": 2,
          "state": {
            "name": "Todo",
            "type": "unstarted"
          },
          "team": {
            "key": "ENG"
          }
        }
      },
      "record": "data",
      "match": "Issue.create"
    },
    "issue.updated": {
      "delivery": "webhook",
      "object": "issue",
      "payload": {
        "action": "update",
        "type": "Issue",
        "createdAt": "2026-10-20T12:00:00.000Z",
        "organizationId": "b0c1d2e3-f4a5-4b6c-8d7e-9f0a1b2c3d4e",
        "webhookTimestamp": 1760961600000,
        "data": {
          "id": "5f1a2b3c-4d5e-4f60-8a7b-9c0d1e2f3a4b",
          "identifier": "ENG-142",
          "title": "Webhook retries double-post comments",
          "priority": 2,
          "state": {
            "name": "In Progress",
            "type": "started"
          }
        },
        "updatedFrom": {
          "stateId": "1d2c3b4a-5e6f-4a7b-8c9d-0e1f2a3b4c5d"
        }
      },
      "record": "data",
      "match": "Issue.update"
    }
  },
  "webhook": {
    "scope": "app",
    "topic": "{{body.type}}.{{body.action}}",
    "eventId": [
      "{{headers.linear-delivery}}",
      "{{body.webhookId}}:{{body.webhookTimestamp}}"
    ],
    "account": "{{body.organizationId}}",
    "verify": "verifyWebhookSignature",
    "note": "Linear-Signature HMAC of the raw body, webhookTimestamp within 60 s. Implemented in api-module-library 659b90d; needs the module release that includes it."
  },
  "capabilities": {
    "issue.get": {
      "kind": "read",
      "method": "issue",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "issue",
      "args": [
        "id"
      ]
    },
    "issue.byIdentifier": {
      "kind": "read",
      "method": "issueByIdentifier",
      "input": {
        "identifier": {
          "type": "string",
          "required": true
        }
      },
      "output": "issue",
      "args": [
        "identifier"
      ]
    },
    "issue.search": {
      "kind": "search",
      "method": "searchIssues",
      "input": {
        "teamId": {
          "type": "string"
        },
        "stateType": {
          "type": "string"
        },
        "updatedBefore": {
          "type": "string"
        },
        "first": {
          "type": "number"
        }
      },
      "output": "issue[]",
      "args": [
        "teamId",
        "stateType",
        "updatedBefore",
        "first"
      ]
    },
    "issue.create": {
      "kind": "write",
      "method": "issueCreate",
      "input": {
        "teamId": {
          "type": "string",
          "required": true
        },
        "title": {
          "type": "string",
          "required": true
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "number"
        },
        "stateName": {
          "type": "string"
        },
        "labelIds": {
          "type": "array"
        }
      },
      "output": "issue",
      "args": [
        "teamId",
        "title",
        "description",
        "priority",
        "stateName",
        "labelIds"
      ]
    },
    "issue.update": {
      "kind": "write",
      "method": "issueUpdate",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "input": {
          "type": "object",
          "required": true
        }
      },
      "output": "issue",
      "args": [
        "id",
        "input"
      ]
    },
    "comment.create": {
      "kind": "write",
      "method": "commentCreate",
      "input": {
        "issueId": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        }
      },
      "output": "comment",
      "args": [
        "issueId",
        "body"
      ]
    },
    "attachment.link": {
      "kind": "write",
      "method": "attachmentLinkURL",
      "input": {
        "issueId": {
          "type": "string",
          "required": true
        },
        "url": {
          "type": "string",
          "required": true
        },
        "title": {
          "type": "string"
        }
      },
      "output": "attachment",
      "args": [
        "issueId",
        "url",
        "title"
      ]
    },
    "team.list": {
      "kind": "read",
      "method": "teams",
      "input": {},
      "output": "team[]",
      "args": []
    },
    "workflowState.list": {
      "kind": "read",
      "method": "workflowStates",
      "input": {
        "teamId": {
          "type": "string",
          "required": true
        }
      },
      "output": "workflowState[]",
      "args": [
        "teamId"
      ]
    }
  },
  "options": {
    "team": {
      "capability": "team.list",
      "label": "{{item.name}} ({{item.key}})",
      "value": "$.item.id"
    },
    "workflowState": {
      "capability": "workflowState.list",
      "label": "{{item.name}}",
      "value": "$.item.name",
      "inputs": {
        "teamId": {
          "type": "string",
          "required": true
        }
      }
    }
  }
}
