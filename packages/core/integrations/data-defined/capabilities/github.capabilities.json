  "webhook": {
    "scope": "app",
    "topic": "{{headers.x-github-event}}.{{body.action}}",
    "eventId": "{{headers.x-github-delivery}}",
    "account": "{{body.installation.id}}",
    "verify": "verifyWebhookSignature"
  },
  "capabilities": {
    "issue.get": {
      "kind": "read",
      "method": "getIssue",
      "input": {
        "owner": {
          "type": "string",
          "required": true
        },
        "repo": {
          "type": "string",
          "required": true
        },
        "issue_number": {
          "type": "number",
          "required": true
        }
      },
      "output": "issue"
    },
    "issue.list": {
      "kind": "read",
      "method": "listIssuesForRepo",
      "input": {
        "owner": {
          "type": "string",
          "required": true
        },
        "repo": {
          "type": "string",
          "required": true
        },
        "state": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "per_page": {
          "type": "number"
        },
        "page": {
          "type": "number"
        }
      },
      "output": "issue[]"
    },
    "issue.create": {
      "kind": "write",
      "method": "createIssue",
      "input": {
        "owner": {
          "type": "string",
          "required": true
        },
        "repo": {
          "type": "string",
          "required": true
        },
        "title": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "string"
        },
        "labels": {
          "type": "array"
        },
        "assignees": {
          "type": "array"
        }
      },
      "output": "issue"
    },
    "issue.update": {
      "kind": "write",
      "method": "updateIssue",
      "input": {
        "owner": {
          "type": "string",
          "required": true
        },
        "repo": {
          "type": "string",
          "required": true
        },
        "issue_number": {
          "type": "number",
          "required": true
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "state_reason": {
          "type": "string"
        },
        "labels": {
          "type": "array"
        }
      },
      "output": "issue"
    },
    "issue.comment": {
      "kind": "write",
      "method": "createIssueComment",
      "input": {
        "owner": {
          "type": "string",
          "required": true
        },
        "repo": {
          "type": "string",
          "required": true
        },
        "issue_number": {
          "type": "number",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        }
      },
      "output": "comment"
    },
    "repo.list": {
      "kind": "read",
      "method": "listInstallationRepos",
      "input": {},
      "output": "repository[]"
    }
  },
  "options": {
    "repo": {
      "capability": "repo.list",
      "label": "{{item.full_name}}",
      "value": "$.item.full_name"
    }
  }
}
