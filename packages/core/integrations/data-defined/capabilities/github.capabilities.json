{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "github",
  "label": "GitHub",
  "package": "@friggframework/api-module-github",
  "version": "1.8.0",
  "auth": "oauth2",
  "objects": {
    "issue": {
      "label": "Issue",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "number",
          "type": "number",
          "tag": "record.displayId",
          "readOnly": true
        },
        {
          "name": "title",
          "type": "string",
          "tag": "task.title"
        },
        {
          "name": "body",
          "type": "text",
          "tag": "task.description"
        },
        {
          "name": "state",
          "type": "enum",
          "tag": "task.state",
          "values": [
            "open",
            "closed"
          ]
        },
        {
          "name": "state_reason",
          "type": "enum",
          "values": [
            "completed",
            "not_planned",
            "reopened"
          ]
        },
        {
          "name": "labels",
          "type": "label[]",
          "tag": "record.tags"
        },
        {
          "name": "labels[0].name",
          "type": "string"
        },
        {
          "name": "assignee.login",
          "type": "string",
          "tag": "record.owner"
        },
        {
          "name": "html_url",
          "type": "string",
          "tag": "record.url",
          "readOnly": true
        },
        {
          "name": "pull_request",
          "type": "json",
          "readOnly": true
        },
        {
          "name": "created_at",
          "type": "datetime",
          "tag": "record.createdAt",
          "readOnly": true
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "tag": "record.updatedAt",
          "readOnly": true
        }
      ]
    },
    "pullRequest": {
      "label": "Pull request",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "number",
          "type": "number",
          "readOnly": true
        },
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "body",
          "type": "text"
        },
        {
          "name": "state",
          "type": "enum",
          "values": [
            "open",
            "closed"
          ]
        },
        {
          "name": "merged",
          "type": "boolean",
          "readOnly": true
        },
        {
          "name": "merged_at",
          "type": "datetime",
          "readOnly": true
        },
        {
          "name": "head.ref",
          "type": "string",
          "tag": "git.branch"
        },
        {
          "name": "base.ref",
          "type": "string"
        },
        {
          "name": "html_url",
          "type": "string",
          "tag": "record.url",
          "readOnly": true
        }
      ]
    }
  },
  "events": {
