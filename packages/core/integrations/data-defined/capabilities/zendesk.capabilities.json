{
  "$schema": "https://friggframework.org/schemas/capability-manifest/v0.1.json",
  "module": "zendesk",
  "label": "Zendesk Support",
  "package": "@friggframework/api-module-zendesk",
  "version": "1.6.0",
  "auth": "oauth2",
  "account": {
    "description": "Values about the connected account, persisted by the module (apiPropertiesToPersist). Definitions read them as $.install.accounts.<module key>.<name>.",
    "fields": [
      {
        "name": "subdomain",
        "type": "string",
        "description": "Zendesk subdomain (acme in acme.zendesk.com)"
      }
    ]
  },
  "objects": {
    "ticket": {
      "label": "Ticket",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "tag": "record.displayId",
          "readOnly": true
        },
        {
          "name": "subject",
          "type": "string",
          "tag": "ticket.subject"
        },
        {
          "name": "description",
          "type": "text",
          "tag": "ticket.description",
          "readOnly": true
        },
        {
          "name": "status",
          "type": "enum",
          "tag": "ticket.status",
          "values": [
            "new",
            "open",
            "pending",
            "hold",
            "solved",
            "closed"
          ]
        },
        {
          "name": "priority",
          "type": "enum",
          "tag": "ticket.priority",
          "values": [
            "low",
            "normal",
            "high",
            "urgent"
          ]
        },
        {
          "name": "type",
          "type": "enum",
          "values": [
            "problem",
            "incident",
            "question",
            "task"
          ]
        },
        {
          "name": "requester_id",
          "type": "string"
        },
        {
          "name": "assignee_id",
          "type": "string",
          "tag": "record.owner"
        },
        {
          "name": "group_id",
          "type": "string"
        },
        {
          "name": "organization_id",
          "type": "string"
        },
        {
          "name": "tags",
          "type": "string[]",
          "tag": "record.tags"
        },
        {
          "name": "external_id",
          "type": "string",
          "tag": "record.externalId"
        },
        {
          "name": "url",
          "type": "string",
          "readOnly": true
        },
        {
          "name": "created_at",
          "type": "datetime",
          "tag": "record.createdAt",
          "readOnly": true
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "tag": "record.updatedAt",
          "readOnly": true
        }
      ]
    },
    "user": {
      "label": "User",
      "fields": [
        {
          "name": "id",
          "type": "id",
          "readOnly": true
        },
        {
          "name": "name",
          "type": "string",
          "tag": "person.fullName"
        },
        {
          "name": "email",
          "type": "email",
          "tag": "contact.email"
        },
        {
          "name": "phone",
          "type": "phone",
          "tag": "contact.phone"
        },
        {
          "name": "role",
          "type": "enum",
          "values": [
            "end-user",
            "agent",
            "admin"
          ]
        },
        {
          "name": "organization_id",
          "type": "string"
        }
      ]
    }
  },
  "events": {
    "ticket.tagsChanged": {
      "delivery": "webhook",
      "object": "ticket",
      "subscribe": "webhook.create",
      "description": "Event-subscription webhook zen:event-type:ticket.tags_changed. $.record is the ticket (detail); added/removed tags are in event.",
      "payload": {
        "account_id": 22129848,
        "detail": {
