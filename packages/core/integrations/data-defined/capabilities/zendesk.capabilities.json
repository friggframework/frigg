        "subject": "zen:ticket:35436",
        "time": "2026-10-20T09:01:02.882Z",
        "type": "zen:event-type:ticket.status_changed",
        "zendesk_event_version": "2022-11-06"
      },
      "record": "detail"
    }
  },
  "capabilities": {
    "ticket.get": {
      "kind": "read",
      "method": "showTicket",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "ticket"
    },
    "ticket.update": {
      "kind": "write",
      "method": "updateTicket",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "ticket": {
          "type": "object",
          "required": true
        }
      },
      "output": "ticket"
    },
    "ticket.addComment": {
      "kind": "write",
      "method": "addTicketComment",
      "input": {
        "id": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        },
        "public": {
          "type": "boolean"
        }
      },
      "output": "ticket"
    },
    "ticket.search": {
      "kind": "search",
      "method": "searchTickets",
      "input": {
        "query": {
          "type": "string",
          "required": true
        }
      },
      "output": "ticket[]"
    },
    "user.get": {
      "kind": "read",
      "method": "showUser",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "user"
    },
    "group.list": {
      "kind": "read",
      "method": "listGroups",
      "input": {},
      "output": "group[]"
    },
    "webhook.create": {
      "kind": "subscribe",
      "method": "createWebhook",
      "input": {
        "name": {
          "type": "string",
          "required": true
        },
        "endpoint": {
          "type": "string",
          "required": true
        },
        "subscriptions": {
          "type": "array",
          "required": true
        }
      },
      "output": "webhook"
    },
    "webhook.delete": {
      "kind": "delete",
      "method": "deleteWebhook",
      "input": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "output": "void"
    }
  },
  "options": {
    "group": {
      "capability": "group.list",
      "label": "{{item.name}}",
      "value": "$.item.id"
    }
  },
  "ui": {
    "placements": [
      "ticket_sidebar",
      "new_ticket_sidebar",
      "user_sidebar",
      "organization_sidebar"
    ],
    "renderer": "frigg-zaf-app"
  }
}
