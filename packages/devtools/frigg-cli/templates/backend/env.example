# Local development settings for `frigg start`. Copy to `.env` and adjust.
STAGE=dev
AWS_REGION=us-east-1

# Any PostgreSQL database reachable from your machine, for example:
#   docker run --name frigg-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frigg

# Deploying: Frigg creates no database (`management: 'external'` in index.js).
# `frigg deploy` reads DATABASE_URL from your shell or CI first and falls back
# to this file, so pass your hosted database explicitly, with TLS required:
#   DATABASE_URL='postgresql://user:password@host:5432/frigg?sslmode=require' \
#     npm run deploy -- --stage prod
# Without a VPC, Lambda egress IPs are not fixed: your provider's access list
# must allow them (see README.md). MongoDB Atlas URLs always use TLS.

# Field-level encryption is bypassed in the dev/test/local stages. A deployed
# non-dev stage uses the KMS key Frigg creates. To exercise AES encryption
# locally, set a 32-character key:
# AES_KEY_ID=local-dev-key
# AES_KEY=change-me-to-a-32-character-secret
