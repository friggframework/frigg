# Local development settings, read by `frigg start` and `frigg db:setup`.
# `frigg init` copied this file to `.env` (git-ignored).
STAGE=dev
AWS_REGION=us-east-1

# Any PostgreSQL database reachable from your machine, for example:
#   docker run --name frigg-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frigg

# Deploying: `frigg deploy` does NOT read this file. It takes DATABASE_URL (and
# every other variable listed as `true` in `environment` in index.js) from the
# shell or CI job that runs it; if unset, the Lambdas get an empty value. Pass
# your hosted database explicitly, with TLS required:
#   DATABASE_URL='postgresql://user:password@host:5432/frigg?sslmode=require' \
#     npm run deploy -- --stage prod
# Without a VPC, Lambda egress IPs are not fixed: your provider's access list
# must allow them (see README.md). MongoDB Atlas URLs always use TLS.

# Field-level encryption is skipped when running locally (`frigg start`), so
# no key is needed here. Deployed stages always encrypt (see README.md).
