# Frigg Backend Environment Variables
# Copy this file to .env and fill in your values

# Core Configuration
BASE_URL=http://localhost:3001
REDIRECT_URI=http://localhost:3001/api/callback

# Database (for local development with Docker)
DATABASE_URL=postgresql://frigg:frigg@localhost:5432/frigg
DATABASE_USER=frigg
DATABASE_PASSWORD=frigg

# Security Keys (generate unique values for production)
HEALTH_API_KEY=your-health-api-key
ADMIN_API_KEY=your-admin-api-key
FRIGG_API_KEY=your-frigg-api-key
FRIGG_APP_USER_ID=your-app-user-id

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket

# Add your integration-specific credentials below
# EXAMPLE_CLIENT_ID=
# EXAMPLE_CLIENT_SECRET=
# EXAMPLE_SCOPE=
